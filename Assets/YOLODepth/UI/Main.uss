:root {
    flex-grow: 1;
    --background: rgba(0, 0, 0, 0);
    --panel: rgba(18, 18, 18, 0.72);
    --text: #f2f2f2;
    --muted: #a0a0a0;
    --accent: #f2f2f2;
}

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 24px;
    background-color: var(--background);
    color: var(--text);
}

.header {
    position: absolute;
    right: 24px;
    top: 24px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.status-label {
    margin-right: 8px;
    color: var(--muted);
    font-size: 13px;
}

.status {
    color: var(--accent);
    font-size: 13px;
    -unity-text-align: middle-right;
}

.viewports {
    position: absolute;
    right: 24px;
    bottom: 24px;
    width: 42%;
    max-width: 560px;
    min-width: 360px;
    height: 24%;
    max-height: 240px;
    min-height: 160px;
    flex-direction: row;
}

.viewport-panel {
    flex-grow: 1;
    flex-basis: 0;
    padding: 12px;
    background-color: var(--panel);
    border-radius: 4px;
}

.viewport-panel-left {
    margin-right: 9px;
}

.viewport-panel-right {
    margin-left: 9px;
}

.viewport-title {
    margin-bottom: 9px;
    color: var(--muted);
    font-size: 12px;
    white-space: nowrap;
}

.viewport-image {
    flex-grow: 1;
    background-color: #000000;
}

.controls {
    position: absolute;
    left: 24px;
    bottom: 24px;
    width: 36%;
    max-width: 480px;
    min-width: 340px;
    padding: 14px 16px;
    background-color: var(--panel);
    border-radius: 4px;
}

.range-title {
    margin-bottom: 4px;
    color: var(--muted);
    font-size: 12px;
}

.range-group {
    margin-top: 8px;
}

.range-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2px;
}

.range-label {
    color: var(--text);
    font-size: 12px;
}

.range-slider {
    height: 22px;
    margin-left: 0;
    margin-right: 0;
}

.range-slider > .unity-base-field__input {
    margin-left: 0;
}

.range-slider .unity-base-slider__drag-container {
    height: 22px;
}

.range-slider .unity-base-slider__tracker {
    position: absolute;
    left: 0;
    top: 9px;
    right: 0;
    height: 4px;
    background-color: rgba(242, 242, 242, 0.28);
    border-width: 0;
    border-radius: 2px;
}

.range-slider .unity-base-slider__dragger-border {
    display: none;
}

.range-slider .unity-base-slider__dragger {
    position: absolute;
    top: 2px;
    width: 18px;
    height: 18px;
    margin: 0;
    background-color: var(--accent);
    border-width: 2px;
    border-color: rgba(242, 242, 242, 0.9);
    border-radius: 9px;
}

.range-slider:hover .unity-base-slider__dragger {
    background-color: #ffffff;
}

.range-value {
    color: var(--accent);
    font-size: 12px;
    -unity-text-align: middle-right;
}
